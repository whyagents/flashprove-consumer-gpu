From 58d630928cd24cfdebb31437929f9c9420560739 Mon Sep 17 00:00:00 2001
From: why-research <why-research@localhost>
Date: Sun, 8 Nov 2026 18:24:19 -0800
Subject: [PATCH 10/12] exp/sm120 p11: Form<PackedSrc>: read the packed table
 from global memory instead of staging 131,072 B in shared memory

Semantics: The same read-only table values: stage() copied exactly the 131,072 bytes of s.ctab, so tab[k] in shared memory equals s.ctab[k] in global memory for every key k < 2^16. stage()'s closing __syncthreads() is kept. Only the memory space (and speed) of the reads changes.
---
 prover/hiding/forest_keys.cuh | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/prover/hiding/forest_keys.cuh b/prover/hiding/forest_keys.cuh
index 417cce43..d63b32b1 100644
--- a/prover/hiding/forest_keys.cuh
+++ b/prover/hiding/forest_keys.cuh
@@ -281,19 +281,21 @@ template <> struct Form<LimbSrc> : ByValues<Form<LimbSrc>> {
 // and lookup_tie::k_tie() raises OWN_TEST (no proof). Same for a range table of under 2^16 rows.
 template <> struct Form<PackedSrc> : ByValues<Form<PackedSrc>> {
   static constexpr int THREADS = 512;
-  static __host__ __device__ int shared(const PackedSrc &) { return POWERS_BYTES + 131072; }
+  // exp/sm120: the 2^16 16-bit entries (131,072 B) no longer fit sm_120's 101,376 B of shared memory per
+  // block, so they are read from GPU memory through the read-only path (__ldg), as Form<RowSrc> reads its rows.
+  static __host__ __device__ int shared(const PackedSrc &) { return POWERS_BYTES; }
   const uint16_t *tab;
   __device__ __forceinline__ void init(const PackedSrc &s, const T &alpha, void *sh) {
     set_powers(alpha, sh);
     init_values(s, sh);
   }
   static constexpr int BITS = 44, NB0 = 4;
-  __device__ __forceinline__ void init_values(const PackedSrc &s, void *sh) {
-    tab = (const uint16_t *)((u8 *)sh + POWERS_BYTES);
-    stage((u8 *)sh + POWERS_BYTES, s.ctab, 131072);
+  __device__ __forceinline__ void init_values(const PackedSrc &s, void *) {
+    tab = s.ctab;
+    __syncthreads(); // the barrier that stage() ended with: init() relies on it after set_powers()
   }
-  __device__ __forceinline__ u64 value(u32 k) const { return (u64)k + ((u64)tab[k] << 28); }
-  __device__ __forceinline__ u64 bytes0(u32 k) const { return k | (u32)tab[k] << 16; }
+  __device__ __forceinline__ u64 value(u32 k) const { return (u64)k + ((u64)__ldg(tab + k) << 28); }
+  __device__ __forceinline__ u64 bytes0(u32 k) const { return k | (u32)__ldg(tab + k) << 16; }
   static __host__ __device__ constexpr int turn0(int b) { return b < 2 ? 8 * b : 12 + 8 * b; }
 };
 // Any other table (GENERAL): the row values are read from GPU memory, 8 bytes per key. A key not
