From 657ad78efc3d63bd29ebe72548b7d27b1bdbdcb5 Mon Sep 17 00:00:00 2001
From: why-research <why-research@localhost>
Date: Sun, 8 Nov 2026 17:57:26 -0800
Subject: [PATCH 04/12] exp/sm120 p04: TILED_STAGES 3 -> 2: k_tiled_multiply
 asked for TILED_ROOM = 110,592 B of dynamic shared memory

Semantics: Exact int8 x int8 -> int32 products (mma.sync), then the same field joins. Only the depth of the copy pipeline changes: with 2 stages, __pipeline_wait_prior(0) completes step s, __syncthreads() frees buffer (s+1) % 2 before fetch(s+1); the static_assert that the sums fit (69,632 <= 73,728) still holds.
---
 prover/engine/tiled.cuh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/prover/engine/tiled.cuh b/prover/engine/tiled.cuh
index 0505fecd..517fdd5a 100644
--- a/prover/engine/tiled.cuh
+++ b/prover/engine/tiled.cuh
@@ -95,7 +95,7 @@ constexpr unsigned TILED_THREADS = 256;
 constexpr unsigned TILED_M = 128, TILED_N = 128; // a block's planes, and its rows of columns' bytes
 constexpr unsigned TILED_COLUMNS = TILED_N / 8;
 constexpr unsigned TILED_STEP = 128;              // places copied to shared memory in one step
-constexpr unsigned TILED_STAGES = 3;
+constexpr unsigned TILED_STAGES = 2; // exp/sm120: was 3; 3 x 36,864 B = 110,592 B > sm_120's 101,376 B per block
 constexpr unsigned TILED_PARTS = TILED_STEP / 16; // 16-byte pieces of one row in a step
 constexpr unsigned TILED_PITCH = TILED_STEP + 16; // bytes from one row of a tile to the next
 constexpr unsigned TILED_STAGE_BYTES = (TILED_M + TILED_N) * TILED_PITCH;
