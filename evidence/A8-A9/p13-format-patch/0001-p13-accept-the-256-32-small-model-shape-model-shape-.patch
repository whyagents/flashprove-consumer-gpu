diff --git a/prover/weights_commitment/fold_weights.cuh b/prover/weights_commitment/fold_weights.cuh
index 35e07f35..a8988635 100644
--- a/prover/weights_commitment/fold_weights.cuh
+++ b/prover/weights_commitment/fold_weights.cuh
@@ -177,13 +177,18 @@ struct Reads {
   const char *norm;
   uint32_t c_word;
 };
-inline Reads reads(const std::string &kind) {
-  if (kind == "attn_q") return {"attn_norm", 0x3DCA62C2u};
-  if (kind == "attn_k" || kind == "attn_v") return {"attn_norm", 0x3F8F1BBDu};
+inline Reads reads(const std::string &kind, uint64_t width = 5120, uint64_t head = 128) {
+  // At width 256, sqrt(d) / 2^floor(log2(sqrt(d))) = 1. This is the
+  // norm convention used by fit_scales at small sizes; query folding adds 1/sqrt(32).
+  const bool small = width == 256 && head == 32;
+  const uint32_t nc = small ? 0x3F800000u : 0x3F8F1BBDu;
+  const uint32_t qc = small ? 0x3E3504F3u : 0x3DCA62C2u;
+  if (kind == "attn_q") return {"attn_norm", qc};
+  if (kind == "attn_k" || kind == "attn_v") return {"attn_norm", nc};
   for (const char *k :
        {"ffn_gate", "ffn_up", "ffn_gate_inp", "ffn_gate_shexp", "ffn_up_shexp", "ffn_gate_exps", "ffn_up_exps"})
-    if (kind == k) return {"ffn_norm", 0x3F8F1BBDu};
-  if (kind == "output") return {"output_norm", 0x3F8F1BBDu};
+    if (kind == k) return {"ffn_norm", nc};
+  if (kind == "output") return {"output_norm", nc};
   return {"", 0};
 }
 
diff --git a/prover/weights_commitment/worst_case.cuh b/prover/weights_commitment/worst_case.cuh
